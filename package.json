{
  "name": "bullmq-groups",
  "version": "0.1.0",
  "private": true,
  "description": "Per-group FIFO and fairness for open-source BullMQ: an alternative to BullMQ Pro's groups, with the same API and a NestJS module",
  "keywords": [
    "bullmq",
    "bullmq-pro",
    "queue",
    "groups",
    "fifo",
    "fairness",
    "redis",
    "nestjs"
  ],
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "nestjs": [
        "dist/nestjs/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/lua && cp src/lua/*.lua dist/lua/",
    "typecheck": "tsc --noEmit",
    "redis:up": "docker run -d --rm --name bullmq-groups-redis -p 127.0.0.1:6390:6379 redis:7-alpine redis-server --save '' --appendonly no",
    "redis:down": "docker rm -f bullmq-groups-redis",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:bullmq": "bash scripts/test-bullmq.sh",
    "test:v6": "bash scripts/test-bullmq.sh 6.3.15",
    "test:min": "bash scripts/test-bullmq.sh 5.40.0",
    "bench": "tsx bench/run.ts"
  },
  "peerDependencies": {
    "bullmq": ">=5.40.0 <7",
    "@nestjs/bullmq": ">=10.0.0",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/bullmq": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "dependencies": {
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@types/node": "^22.20.5",
    "bullmq": "5.81.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
